{
  "compilerOptions": {
    "tsBuildInfoFile": "./.tsbuildinfo",
    "incremental": true,
    "target": "ES6",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "paths": {
      "@config/*": ["config/*"],
      "@errors/*": ["errors/*"],
      "@routes/*": ["routes/*"],
      "@controllers/*": ["controllers/*"],
      "@services/*": ["services/*"],
      "@models/*": ["models/*"],
      "@utils/*": ["utils/*"],
      "@entities/*": ["entities/*"],
      "@repositories/*": ["repositories/*"],
      "@middlewares/*": ["middlewares/*"],
      "@lib/*": ["lib/*"]

    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
